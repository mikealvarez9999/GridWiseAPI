# Comma-separated list of Groq API keys (one is enough; several are rotated on rate limits)
GROQ_API_KEYS=gsk_replace_me_1,gsk_replace_me_2
# Primary language model used to interpret operator notes
GROQ_MODEL=openai/gpt-oss-120b
# Fallback models tried (in order) when every key is rate-limited/unavailable for the primary model
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile
# low | medium | high  (gpt-oss reasoning effort; low is fast and sufficient for extraction)
GROQ_REASONING_EFFORT=low
# Per-LLM-call timeout and whole-request budget, in seconds (judge timeout is 30 s)
LLM_TIMEOUT_S=10
REQUEST_BUDGET_S=25
# Port the server binds to (Render/Docker inject PORT)
PORT=8000
# Set to 1 ONLY for offline smoke tests: every note becomes no_op without calling the LLM
LLM_MOCK=0
